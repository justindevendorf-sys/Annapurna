# Copy this file to .env and fill in real values. Never commit .env.

# ---- Who the weekly summary goes to ----
# Comma-separated list. Leave blank until both addresses are confirmed.
PARENT_EMAILS=

# Used to personalize the report subject/body. Optional.
CHILD_NAME=

# ---- When the weekly summary is sent ----
# Cron syntax (minute hour day month weekday). Default: Sunday 6:00 PM.
REPORT_CRON=0 18 * * 0
REPORT_TIMEZONE=America/New_York

# ---- Email sending: tried in this order, first configured one that succeeds wins ----

# 1) iCloud Mail
#    Create an app-specific password at appleid.apple.com > Sign-In and Security > App-Specific Passwords
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=

# 2) Gmail (fallback if iCloud isn't set up or fails)
#    Requires 2-Step Verification, then an app password at myaccount.google.com/apppasswords
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# 3) Resend free tier (fallback if neither of the above is configured/working)
#    Sign up at resend.com - free tier includes 100 emails/day with no domain setup required
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

PORT=3000
